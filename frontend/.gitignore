# ==============================================================================
# Next.js / React Frontend .gitignore
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pmlink

# Next.js build output
/.next/
/out/

# Production builds
/build
/dist

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Diagnostic / coverage
/coverage
/.nyc_output

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
.turbo
.vercel

