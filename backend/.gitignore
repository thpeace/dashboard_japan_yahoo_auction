# ==============================================================================
# Spring Boot / Maven Backend .gitignore
# ==============================================================================

# Compiled class files & build artifacts
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven release plugin
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# Logs
*.log
logs/

# IDE & Editor files
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/
bin/

# Java crash logs
hs_err_pid*
replay_pid*

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# Environment / Secret overrides
*.env
application-local.yml
application-local.properties
application-secret.yml
application-secret.properties
*.key
*.pem
*.jks
*.p12

